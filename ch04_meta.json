ference": -3, "id": "42"}, {"url": "https://i.ytimg.com/vi_webp/yjWyvQm2Blw/hq720.webp", "preference": -2, "id": "43"}, {"url": "https://i.ytimg.com/vi/yjWyvQm2Blw/maxresdefault.jpg", "preference": -1, "id": "44"}, {"url": "https://i.ytimg.com/vi_webp/yjWyvQm2Blw/maxresdefault.webp", "preference": 0, "id": "45"}], "thumbnail": "https://i.ytimg.com/vi/yjWyvQm2Blw/sddefault.jpg?sqp=-oaymwEmCIAFEOAD8quKqQMa8AEB-AH-BIAC6AKKAgwIABABGEkgWShlMA8=&rs=AOn4CLCGn7rOdQOsUVtOGKP30NWVMh0Qew", "description": "\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 4o: H \"\u03a7\u03c1\u03c5\u03c3\u03ae \u039f\u03c1\u03b4\u03ae\" \u03c4\u03bf\u03c5 \u03a4\u03b6\u03ad\u03bd\u03b3\u03ba\u03b9\u03c2 \u03a7\u03b1\u03bd - \u0395\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae \u03c3\u03c4\u03b7 \u0398\u03b5\u03c9\u03c1\u03af\u03b1 \u03c4\u03c9\u03bd \u0398\u03c1\u03b7\u03c3\u03ba\u03b5\u03b9\u03ce\u03bd. \u0397 playlist \u03c4\u03b7\u03c2 \u03c3\u03b5\u03b9\u03c1\u03ac\u03c2 \u03b2\u03b9\u03bd\u03c4\u03b5\u03bf\u03bc\u03b1\u03b8\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd ''\u0397 \u0391\u03bd\u03b8\u03c1\u03ce\u03c0\u03b9\u03bd\u03b7 \u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1: \u0394\u03b5\u03ba\u03b1\u03b5\u03bd\u03bd\u03ad\u03b1 \u03bc\u03b9\u03ba\u03c1\u03ac \u03bc\u03b1\u03b8\u03ae\u03bc\u03b1\u03c4\u03b1 \u03b3\u03b9\u03b1 \u03ad\u03bd\u03b1\u03bd \u039c\u03b5\u03b3\u03ac\u03bb\u03bf \u039a\u03cc\u03c3\u03bc\u03bf [\u039c\u03b1\u03c1\u03af\u03b1 \u0395\u03c5\u03b8\u03c5\u03bc\u03af\u03bf\u03c5]'': https://www.youtube.com/playlist?list=PLlz0pQKPcu894vuwhqnIsuC6xCqdHSDjn\n\n\u0397 \u039c\u03b1\u03c1\u03af\u03b1 \u0395\u03c5\u03b8\u03c5\u03bc\u03af\u03bf\u03c5 (\u039b\u03ac\u03c1\u03b9\u03c3\u03b1, 1955) \u03b5\u03af\u03bd\u03b1\u03b9 \u0395\u03bb\u03bb\u03b7\u03bd\u03af\u03b4\u03b1 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03cc\u03c2 \u03ba\u03b1\u03b9 \u03ba\u03b1\u03b8\u03b7\u03b3\u03ae\u03c4\u03c1\u03b9\u03b1 \u03c0\u03b1\u03bd\u03b5\u03c0\u03b9\u03c3\u03c4\u03b7\u03bc\u03af\u03bf\u03c5, \u03b5\u03c1\u03b5\u03c5\u03bd\u03ae\u03c4\u03c1\u03b9\u03b1 \u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1\u03c2 \u03ba\u03b1\u03b9 \u0391\u03c1\u03c7\u03b1\u03b9\u03bf\u03bb\u03bf\u03b3\u03af\u03b1\u03c2, \u03c3\u03c5\u03b3\u03b3\u03c1\u03b1\u03c6\u03ad\u03b1\u03c2 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ce\u03bd \u03b2\u03b9\u03b2\u03bb\u03af\u03c9\u03bd, \u03b5\u03c0\u03b9\u03bc\u03b5\u03bb\u03ae\u03c4\u03c1\u03b9\u03b1 \u03ba\u03b1\u03b9 \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03ac\u03c4\u03b7\u03c2 \u03c3\u03c5\u03bb\u03bb\u03bf\u03b3\u03b9\u03ba\u03ce\u03bd \u03ad\u03c1\u03b3\u03c9\u03bd \u03ba\u03b1\u03b9 \u03b1\u03c1\u03b8\u03c1\u03bf\u03b3\u03c1\u03ac\u03c6\u03bf\u03c2 \u03c3\u03c4\u03b7\u03bd \u0395\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ae, \u0393\u03b1\u03bb\u03bb\u03b9\u03ba\u03ae \u03ba\u03b1\u03b9 \u0391\u03b3\u03b3\u03bb\u03b9\u03ba\u03ae \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1. \u0395\u03af\u03bd\u03b1\u03b9 \u03b2\u03c1\u03b1\u03b2\u03b5\u03c5\u03bc\u03ad\u03bd\u03b7 \u03bc\u03b5 \u03c4\u03bf \u0392\u03c1\u03b1\u03b2\u03b5\u03af\u03bf \u0395\u03be\u03b1\u03af\u03c1\u03b5\u03c4\u03b7\u03c2 \u03a0\u03b1\u03bd\u03b5\u03c0\u03b9\u03c3\u03c4\u03b7\u03bc\u03b9\u03b1\u03ba\u03ae\u03c2 \u0394\u03b9\u03b4\u03b1\u03c3\u03ba\u03b1\u03bb\u03af\u03b1\u03c2.\n\n\u03a3\u03c4\u03b1 \u03bc\u03b1\u03b8\u03ae\u03bc\u03b1\u03c4\u03b1 \u03b1\u03c5\u03c4\u03ac \u03b5\u03bd\u03c4\u03bf\u03c0\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03ba\u03bf\u03bc\u03b2\u03b9\u03ba\u03ac \u03c3\u03b7\u03bc\u03b5\u03af\u03b1 \u03c4\u03b7\u03c2 \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03b9\u03bd\u03b7\u03c2 \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1\u03c2: \u03b7 \u03c0\u03b5\u03c1\u03af\u03bf\u03b4\u03bf\u03c2 \u03ba\u03b1\u03c1\u03c0\u03bf\u03c3\u03c5\u03bb\u03bb\u03bf\u03b3\u03ae\u03c2 \u03ba\u03b1\u03b9 \u03ba\u03c5\u03bd\u03b7\u03b3\u03af\u03bf\u03c5, \u03b7 \u0393\u03b5\u03c9\u03c1\u03b3\u03b9\u03ba\u03ae \u0395\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7, \u03b7 \u0392\u03b9\u03bf\u03bc\u03b7\u03c7\u03b1\u03bd\u03b9\u03ba\u03ae \u0395\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7. \u0391\u03bd\u03b1\u03bb\u03cd\u03b5\u03c4\u03b1\u03b9 \u03b7 \u03c0\u03bf\u03c1\u03b5\u03af\u03b1 \u03c4\u03c9\u03bd \u03bc\u03b5\u03b3\u03ac\u03bb\u03c9\u03bd \u03b5\u03bd\u03b5\u03c1\u03b3\u03ce\u03bd \u03b8\u03c1\u03b7\u03c3\u03ba\u03b5\u03b9\u03ce\u03bd \u03c4\u03b7\u03c2 \u0393\u03b7\u03c2 \u2013\u03ba\u03b1\u03b9 \u03c4\u03c9\u03bd \u03bf\u03c0\u03b1\u03b4\u03ce\u03bd \u03c4\u03bf\u03c5\u03c2. \u0391\u03bd\u03b1\u03b4\u03b5\u03b9\u03ba\u03bd\u03cd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c4\u03b1 \u03b3\u03b5\u03bd\u03b9\u03ba\u03ac \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03b7\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac \u03b5\u03c5\u03c1\u03cd\u03c4\u03b5\u03c1\u03c9\u03bd \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03bc\u03b9\u03ba\u03ce\u03bd \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ce\u03bd \u03c4\u03b7\u03c2 \u0393\u03b7\u03c2 (\u0395\u03b3\u03b3\u03cd\u03c2 \u03ba\u03b1\u03b9 \u039c\u03ad\u03c3\u03b7 \u0391\u03bd\u03b1\u03c4\u03bf\u03bb\u03ae, \u0391\u03c6\u03c1\u03b9\u03ba\u03ae, \u0391\u03c5\u03c3\u03c4\u03c1\u03b1\u03bb\u03af\u03b1, \u039a\u03b5\u03bd\u03c4\u03c1\u03b9\u03ba\u03ae \u0391\u03c3\u03af\u03b1 \u03ba\u03b1\u03b9 \u0386\u03c0\u03c9 \u0391\u03bd\u03b1\u03c4\u03bf\u03bb\u03ae, \u0399\u03bd\u03b4\u03af\u03b1, \u039a\u03af\u03bd\u03b1, \u0399\u03b1\u03c0\u03c9\u03bd\u03af\u03b1, \u03a1\u03c9\u03c3\u03af\u03b1, \u0395\u03c5\u03c1\u03ce\u03c0\u03b7, \u0391\u03bc\u03b5\u03c1\u03b9\u03ba\u03ae), \u03bc\u03b5 \u03ad\u03bc\u03c6\u03b1\u03c3\u03b7 \u03c3\u03c4\u03b9\u03c2 \u03ba\u03b5\u03bd\u03c4\u03c1\u03b9\u03ba\u03ad\u03c2 \u03c0\u03b1\u03c1\u03b1\u03bc\u03ad\u03c4\u03c1\u03bf\u03c5\u03c2 \u03c0\u03bf\u03c5 \u03b4\u03b9\u03b1\u03bc\u03cc\u03c1\u03c6\u03c9\u03c3\u03b1\u03bd \u03c4\u03bf\u03c5\u03c2 \u03bc\u03b5\u03b3\u03ac\u03bb\u03bf\u03c5\u03c2 \u03b5\u03c0\u03ce\u03bd\u03c5\u03bc\u03bf\u03c5\u03c2 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03bc\u03bf\u03cd\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b9\u03c2 \u03c0\u03b5\u03c1\u03b9\u03c6\u03ad\u03c1\u03b5\u03b9\u03ad\u03c2 \u03c4\u03bf\u03c5\u03c2. \u039a\u03b1\u03b8\u03ce\u03c2 \u03bf \u03ad\u03bb\u03bb\u03b7\u03bd\u03b1\u03c2 \u03b1\u03ba\u03c1\u03bf\u03b1\u03c4\u03ae\u03c2 \u03b3\u03bd\u03c9\u03c1\u03af\u03b6\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1 \u03c4\u03bf\u03c5 \u03b1\u03c0\u03cc \u03c4\u03b7 \u03c3\u03c7\u03bf\u03bb\u03b9\u03ba\u03ae \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03cc\u03bb\u03b7 \u03c4\u03bf\u03c5 \u03b5\u03ba\u03c0\u03b1\u03af\u03b4\u03b5\u03c5\u03c3\u03b7, \u03b7 \u03b5\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ae \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1 \u03b4\u03b5\u03bd \u03b1\u03bd\u03c4\u03b9\u03bc\u03b5\u03c4\u03c9\u03c0\u03af\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c5\u03bd\u03c4\u03b5\u03c4\u03b1\u03b3\u03bc\u03ad\u03bd\u03b1, \u03bf\u03cd\u03c4\u03c9\u03c2 \u03ce\u03c3\u03c4\u03b5 \u03bd\u03b1 \u03b4\u03bf\u03b8\u03b5\u03af \u03c7\u03ce\u03c1\u03bf\u03c2 \u03c3\u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03c3\u03ad\u03b3\u03b3\u03b9\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03b9\u03c3\u03c4\u03bf\u03c1\u03af\u03b1\u03c2 \u03c4\u03c9\u03bd \u03b5\u03c5\u03c1\u03cd\u03c4\u03b5\u03c1\u03c9\u03bd \u03c0\u03b5\u03c1\u03b9\u03bf\u03c7\u03ce\u03bd \u03c4\u03b7\u03c2 \u0393\u03b7\u03c2 \u2013\u03c0\u03bf\u03c5 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af, \u03b5\u03be\u03ac\u03bb\u03bb\u03bf\u03c5, \u03ba\u03b1\u03b9 \u03c4\u03bf\u03bd \u03c3\u03c4\u03cc\u03c7\u03bf \u03c4\u03bf\u03c5 \u03b5\u03bd \u03bb\u03cc\u03b3\u03c9 \u039a\u03cd\u03ba\u03bb\u03bf\u03c5.\n\n*** \u0394\u03b5\u03ba\u03b1\u03b5\u03bd\u03bd\u03ad\u03b1 \u03bc\u03b9\u03ba\u03c1\u03ac \u03bc\u03b1\u03b8\u03ae\u03bc\u03b1\u03c4\u03b1 \u03b3\u03b9\u03b1 \u03ad\u03bd\u03b1\u03bd \u039c\u03b5\u03b3\u03ac\u03bb\u03bf \u039a\u03cc\u03c3\u03bc\u03bf: ***\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 1\u03bf: \u03a4\u03c1\u03bf\u03c6\u03bf\u03c3\u03c5\u03bb\u03bb\u03ad\u03ba\u03c4\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03ba\u03c5\u03bd\u03b7\u03b3\u03cc\u03c2: \u0397 \u03bc\u03b1\u03ba\u03c1\u03ac \u03c0\u03bf\u03c1\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5 \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03bf\u03c5 \u03c0\u03c1\u03bf\u03c2 \u03c4\u03b7\u03bd \u0393\u03b5\u03c9\u03c1\u03b3\u03b9\u03ba\u03ae \u0395\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 2\u03bf: \u0397 \u03c0\u03bf\u03c1\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5 \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03bf\u03c5 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03c0\u03c1\u03ce\u03c4\u03b7 \u03c4\u03bf\u03c5 \u03b5\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7 \u03ad\u03c9\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u0393\u03b5\u03c9\u03c1\u03b3\u03b9\u03ba\u03ae \u0395\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c4\u03bf\u03c5\u03c2 \u03bb\u03b1\u03bf\u03cd\u03c2 \u03c4\u03c9\u03bd \u03c3\u03c4\u03b5\u03c0\u03ce\u03bd\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 3\u03bf: \u03a4\u03b1 \u03b5\u03c0\u03b9\u03c4\u03b5\u03cd\u03b3\u03bc\u03b1\u03c4\u03b1 \u03c4\u03c9\u03bd \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03c9\u03bd \u03c4\u03b7\u03c2 \u0393\u03b5\u03c9\u03c1\u03b3\u03b9\u03ba\u03ae\u03c2 \u0395\u03c0\u03b1\u03bd\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 4o: H \"\u03a7\u03c1\u03c5\u03c3\u03ae \u039f\u03c1\u03b4\u03ae\" \u03c4\u03bf\u03c5 \u03a4\u03b6\u03ad\u03bd\u03b3\u03ba\u03b9\u03c2 \u03a7\u03b1\u03bd - \u0395\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae \u03c3\u03c4\u03b7 \u0398\u03b5\u03c9\u03c1\u03af\u03b1 \u03c4\u03c9\u03bd \u0398\u03c1\u03b7\u03c3\u03ba\u03b5\u03b9\u03ce\u03bd\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 5\u03bf: \u0399\u03bd\u03b4\u03bf\u03c5\u03b9\u03c3\u03bc\u03cc\u03c2 - \u0392\u03bf\u03c5\u03b4\u03b9\u03c3\u03bc\u03cc\u03c2 - \u03a4\u03b1\u03bf\u03ca\u03c3\u03bc\u03cc\u03c2\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 6\u03bf: \u039a\u03bf\u03bc\u03c6\u03bf\u03c5\u03ba\u03b9\u03b1\u03bd\u03b9\u03c3\u03bc\u03cc\u03c2 - \u0396\u03c9\u03c1\u03bf\u03b1\u03c3\u03c4\u03c1\u03b9\u03c3\u03bc\u03cc\u03c2 - \u0395\u03b2\u03c1\u03b1\u03ca\u03c3\u03bc\u03cc\u03c2\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 7\u03bf: \u0395\u03b2\u03c1\u03b1\u03ca\u03c3\u03bc\u03cc\u03c2 - \u03a7\u03c1\u03b9\u03c3\u03c4\u03b9\u03b1\u03bd\u03b9\u03c3\u03bc\u03cc\u03c2\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 8\u03bf: \u03a7\u03c1\u03b9\u03c3\u03c4\u03b9\u03b1\u03bd\u03b9\u03c3\u03bc\u03cc\u03c2 (\u0391\u0384\u03bc\u03ad\u03c1\u03bf\u03c2)\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 9\u03bf: \u03a7\u03c1\u03b9\u03c3\u03c4\u03b9\u03b1\u03bd\u03b9\u03c3\u03bc\u03cc\u03c2 (\u0392\u0384\u03bc\u03ad\u03c1\u03bf\u03c2)\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 10\u03bf: \u03a7\u03c1\u03b9\u03c3\u03c4\u03b9\u03b1\u03bd\u03b9\u03c3\u03bc\u03cc\u03c2 (\u0393\u0384\u03bc\u03ad\u03c1\u03bf\u03c2)\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 11\u03bf: \u03a7\u03c1\u03b9\u03c3\u03c4\u03b9\u03b1\u03bd\u03b9\u03c3\u03bc\u03cc\u03c2 (\u03a4\u03ad\u03c4\u03b1\u03c1\u03c4\u03bf \u03ba\u03b1\u03b9 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03bf \u039c\u03ad\u03c1\u03bf\u03c2)\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 12\u03bf: \u0399\u03c3\u03bb\u03ac\u03bc\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 13\u03bf: \u0391\u03c1\u03b1\u03b2\u03b9\u03ba\u03cc\u03c2 \u03c0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03bc\u03cc\u03c2 / \u0399\u03bd\u03b4\u03af\u03b1\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 14\u03bf: \u0399\u03bd\u03b4\u03af\u03b1 / \u039a\u03af\u03bd\u03b1\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 15\u03bf: \u039a\u03af\u03bd\u03b1 / \u0399\u03b1\u03c0\u03c9\u03bd\u03af\u03b1\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 16\u03bf: \u039a\u03af\u03bd\u03b1 / \u039d\u03bf\u03c4\u03b9\u03bf\u03b1\u03bd\u03b1\u03c4\u03bf\u03bb\u03b9\u03ba\u03ae \u0391\u03c3\u03af\u03b1\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 17\u03bf: \u03a1\u03c9\u03c3\u03af\u03b1\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 18\u03bf: \u03a1\u03c9\u03c3\u03af\u03b1 / \u039a\u03cc\u03c3\u03bc\u03bf\u03c2\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 19\u03bf: \u039a\u03cc\u03c3\u03bc\u03bf\u03c2\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 \u03a4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03bf (\u03a0\u03c1\u03ce\u03c4\u03bf \u039c\u03ad\u03c1\u03bf\u03c2): \u03a0\u03b1\u03b3\u03ba\u03cc\u03c3\u03bc\u03b9\u03b1 \u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1 - \u039f \u03ba\u03cc\u03c3\u03bc\u03bf\u03c2\n\u039c\u03ac\u03b8\u03b7\u03bc\u03b1 \u03a4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03bf (\u0394\u03b5\u03cd\u03c4\u03b5\u03c1\u03bf \u039c\u03ad\u03c1\u03bf\u03c2): \u03a0\u03b1\u03b3\u03ba\u03cc\u03c3\u03bc\u03b9\u03b1 \u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1 - \u03bc\u03b9\u03b1 \u03b1\u03bd\u03b1\u03ba\u03b5\u03c6\u03b1\u03bb\u03b1\u03af\u03c9\u03c3\u03b7 \u03bc\u03b5 \u03bc\u03bf\u03c5\u03c3\u03b9\u03ba\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03b5\u03b9\u03ba\u03cc\u03bd\u03b5\u03c2.\n\n#\u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1 #\u0391\u03bd\u03b8\u03c1\u03ce\u03c0\u03b9\u03bd\u03b7\u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1 #\u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1\u0391\u03bd\u03b8\u03c1\u03ce\u03c0\u03bf\u03c5 #\u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1\u03a0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03bc\u03bf\u03cd #\u03b8\u03c1\u03b7\u03c3\u03ba\u03b5\u03af\u03b5\u03c2 #\u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1\u0398\u03c1\u03b7\u03c3\u03ba\u03b5\u03b9\u03ce\u03bd #\u0399\u03c3\u03bb\u03ac\u03bc #\u039c\u03bf\u03c5\u03c3\u03bf\u03c5\u03bb\u03bc\u03b1\u03bd\u03b9\u03c3\u03bc\u03cc\u03c2 #\u0399\u03bd\u03b4\u03af\u03b1 #\u0391\u03c1\u03b1\u03b2\u03b9\u03ba\u03cc\u03c2\u03a0\u03bf\u03bb\u03b9\u03c4\u03b9\u03c3\u03bc\u03cc\u03c2 #\u0395\u03c5\u03b8\u03c5\u03bc\u03af\u03bf\u03c5\n\n..", "channel_id": "UCRh_HnjFlrHFTx_xK5o-_Kg", "channel_url": "https://www.youtube.com/channel/UCRh_HnjFlrHFTx_xK5o-_Kg", "duration": 9633, "view_count": 3259, "average_rating": null, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=yjWyvQm2Blw", "categories": ["Education"], "ta